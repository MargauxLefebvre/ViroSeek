process {
    cpus = 1
    time = '4h'
    maxForks = 20
    shell = ['/bin/bash', '-euo', 'pipefail']
    stageOutMode = 'rsync'

    withLabel:fastqc {
        cpus = 16
        memory = '16 GB'
    }
    withLabel:trimgalore {
        cpus = 16
        memory = '16 GB'
    }
    withLabel:fastp {
        cpus = 16
        memory = '16 GB'
    }
    withLabel:bbmap {
        cpus = 16
        memory = '34 GB'
    }
    withLabel:spades {
        cpus = 32
        memory = '72 GB'
    }
    withLabel:minimap2 {
        cpus = 16
        memory = '48 GB'
    }
    withLabel:samtools {
        cpus = 16
        memory = '32 GB'
    }
    withName:taxo_assign_diamond {
        cpus = 32
        time = '24h'
        memory = '72 GB'
    }
    withName:taxo_table_taxonkit {
        cpus = 1
        memory = '4 GB'
    }
    withName:taxo_quanti {
        cpus = 1
        memory = '4 GB'
    }
}
